BOT_TOKEN=replace_me
DATABASE_URL=postgresql+asyncpg://gamestore:change_me@db:5432/gamestore
POSTGRES_DB=gamestore
POSTGRES_USER=gamestore
POSTGRES_PASSWORD=change_me
ADMIN_IDS=123456789
STORE_NAME=DEXLO
SUPPORT_CONTACT=@your_support
RULES_TEXT=Перед оформлением проверьте название, регион и цену выбранного товара.
# Public documents. Fill operator details before enabling payments.
LEGAL_DOCUMENT_DATE=12 октября 2026 года
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
RESELLCODES_API_KEY=
# Fixed rubles per 1 USD in minor units (kopecks). Empty means USD imports are not shown as RUB.
USD_TO_RUB_MINOR=
# Curated import profile. Steam Gifts endpoint returns supplier's top games.
STEAM_GIFT_LIMIT=100
# Game keys lack a documented popularity signal; leave disabled unless you deliberately need them.
IMPORT_STEAM_KEYS=false
# Supplier search queries and stable category-ID prefixes for the selected gift-card brands.
GIFT_CARD_QUERIES=Steam,PlayStation,Xbox,Nintendo,Roblox,App Store,Google Play,Spotify
GIFT_CARD_PREFIXES=steam_,playstation_,xbox_,nintendo_,roblox_,app_store_itunes_,google_play_,spotify_
# Region suffixes accepted from a supplier category_id; prevents every global variant from appearing.
GIFT_CARD_REGIONS=RU,GLOBAL,CIS
# Steam Gift offers shown to customers; avoids thousands of foreign-region duplicates.
STEAM_GIFT_REGIONS=RU,CIS
# Local admin panel (http://localhost:8080). Create the hash with:
# docker compose run --rm admin-api python -m admin_api.password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_WEB_PORT=8080
ADMIN_WEB_BIND=127.0.0.1
